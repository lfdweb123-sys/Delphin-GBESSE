rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/adminUsers/$(request.auth.uid));
    }
    function isPublished() {
      return resource.data.status == 'published' &&
             resource.data.verificationStatus == 'verified';
    }
    function isContent(col) {
      return col in ['profile', 'timeline', 'events', 'activities', 'achievements', 'projects',
                     'organizations', 'companies', 'news', 'gallery', 'socialLinks', 'settings'];
    }

    // Contenus du site : le public lit uniquement ce qui est publié ET vérifié.
    // L'administrateur lit et écrit tout.
    match /{col}/{id} {
      allow read: if isContent(col) && (isPublished() || isAdmin());
      allow create, update, delete: if isContent(col) && isAdmin();
    }

    // Images : lecture à l'unité pour tous (le site les sert via /img/<id>),
    // pas de listage public. Écriture réservée à l'admin, WebP et taille limitées.
    match /images/{id} {
      allow get: if true;
      allow list: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.contentType == 'image/webp'
        && request.resource.data.data is string
        && request.resource.data.data.size() < 950000;
      allow delete: if isAdmin();
    }

    // J'aime : un compteur public par article. Lecture libre ; +1 ou -1 uniquement, jamais négatif.
    match /newsStats/{id} {
      allow get: if true;
      allow list, delete: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['likes']) && request.resource.data.likes == 1;
      allow update: if request.resource.data.keys().hasOnly(['likes'])
        && request.resource.data.likes is int
        && request.resource.data.likes >= 0
        && (request.resource.data.likes == resource.data.likes + 1 || request.resource.data.likes == resource.data.likes - 1);
    }

    // Commentaires : tout visiteur peut en proposer (statut « pending », taille limitée) ;
    // seuls les commentaires approuvés par l'administrateur (« published ») sont lisibles par le public.
    match /comments/{id} {
      allow get, list: if resource.data.status == 'published' || isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['newsId', 'author', 'text', 'status', 'createdAt'])
        && request.resource.data.status == 'pending'
        && request.resource.data.newsId is string && request.resource.data.newsId.size() > 0 && request.resource.data.newsId.size() <= 160
        && request.resource.data.author is string && request.resource.data.author.size() >= 2 && request.resource.data.author.size() <= 60
        && request.resource.data.text is string && request.resource.data.text.size() >= 2 && request.resource.data.text.size() <= 1000
        && request.resource.data.createdAt is string && request.resource.data.createdAt.size() <= 40;
      allow update, delete: if isAdmin();
    }

    // Sources : jamais publiques.
    match /sources/{id} {
      allow read, write: if isAdmin();
    }

    // Liste des administrateurs : chacun ne lit que son propre document.
    // Aucune écriture depuis le site : création uniquement depuis la console Firebase.
    match /adminUsers/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
