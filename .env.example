# --- Firebase (client, publiques par conception : protégées par les règles Firestore/Storage) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# --- URL publique du site (SEO, sitemap, canonical) ---
NEXT_PUBLIC_SITE_URL=https://votre-domaine.com
# --- Script d'import UNIQUEMENT (local, ne jamais déployer) ---
# Chemin vers la clé de compte de service téléchargée depuis la console Firebase
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccount.json
